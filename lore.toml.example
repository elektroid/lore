[server]
# "localhost" = loopback uniquement ; "0.0.0.0" = toutes les interfaces réseau
host = "localhost"
port = 8080
# secure_cookies = true  # mettre à true en production (HTTPS)

[database]
path = "lore.db"

[uploads]
dir = "./data/uploads"

[jwt]
# Obligatoire en production — générer avec : openssl rand -hex 32
secret = "change-me-in-production"
# access_expiry  = "24h"
# refresh_expiry = "168h"

[cors]
origins     = ["http://localhost:5173"]
credentials = true

[llm]
# Toute API compatible OpenAI (Ollama, OpenAI, Anthropic, Mistral…)
base_url   = "http://localhost:11434/v1"
api_key    = "ollama"
model      = "llama3.2:latest"
max_tokens = 0

[mistral]
# Optionnel — génération d'images via Mistral AI
# api_key    = "votre-clé-api-mistral"
# image_count = 3

[bootstrap]
# Crée le premier compte superutilisateur au premier lancement (ignoré ensuite)
# user = "admin@exemple.com:motdepasse:superuser"

[crypto]
# Clé de chiffrement des clés d'API stockées en base.
# Si vide, jwt.secret est utilisé — mais dans ce cas, changer jwt.secret rend
# les clés d'API enregistrées illisibles. Générer avec : openssl rand -hex 32
# key = "..."

[auth]
# "open"   : n'importe qui peut créer un compte (défaut)
# "closed" : seuls le compte bootstrap et ceux créés par un administrateur
registration = "open"

[smtp]
# Optionnel — sans host renseigné, aucun email n'est envoyé (mot de passe
# oublié inclus : le formulaire reste utilisable mais ne fait plus rien).
# host     = "smtp.mail.ovh.net"
# port     = 587
# username = "noreply@exemple.com"
# password = "..."
# from     = "Lore Engine <noreply@exemple.com>"
